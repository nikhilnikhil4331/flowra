# ------------------------------------------------------------------
# Flagsmith
# ------------------------------------------------------------------
# The project's read-only ENVIRONMENT key for client-side use.
#
# How to get it:
#   1. Open Flagsmith (cloud.flagsmith.com) -> your project.
#   2. Open the environment you want the experiment to run in.
#   3. Copy the Environment Key (read-only) from the Environment's
#      "SDK keys" / "API" section. Client apps only ever need the read-only
#      environment key — the app degrades safely to the control variant if
#      this is missing or the SDK fails.
#
# This variable is safe to expose in the browser (it is a read-only key baked
# into the SPA bundle), and is never used server-side.
VITE_FLAGSMITH_SDK_KEY=PLACEHOLDER_PENDING_YOU_PASTE_HERE

# ------------------------------------------------------------------
# Supabase (funnel events backend)
# ------------------------------------------------------------------
# Public URL + publishable (anon) key for the project that hosts the
# myflo_experiment_events table. The app only INSERTs anonymous events and the
# table only allows inserts for `anon` — reads are dashboard-only.
# Copy both from the Supabase project's Settings -> API section.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
