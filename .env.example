# Client configuration — only public values belong in VITE_ variables.
# Leave blank for Myflo's local-first private mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Relative server routes are safe to expose to the browser. Do not place provider keys
# in VITE_ variables or browser bundles.
VITE_FOOD_ANALYSIS_ENDPOINT=/api/food-analysis
VITE_NUTRITION_LOOKUP_ENDPOINT=/api/nutrition/lookup
VITE_HEALTH_COMPANION_ENDPOINT=/api/companion

# Server / edge-function configuration only (never add these to client-side code):
# SUPABASE_SERVICE_ROLE_KEY=
# FOOD_VISION_PROVIDER_API_KEY=
# NUTRITION_DATABASE_API_KEY=
# HEALTH_AI_PROVIDER_API_KEY=
# PUSH_PROVIDER_PRIVATE_KEY=
