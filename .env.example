# Flagsmith client SDK key — the project's read-only, browser-safe SDK key.
# Create your app under Flagsmith -> Settings -> API Keys (or use the setup
# prompt in FLAGSMITH.md). Paste it here (or in .env.local) to turn the
# experiment live. The app runs with the control variant until this is set.
VITE_FLAGSMITH_SDK_KEY=PLACEHOLDER_PENDING_YOU_PASTE_HERE

# Supabase (the connected "NikNote" project) — public URL + publishable key.
# Safe to expose in the browser: the table only allows anonymous inserts.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
